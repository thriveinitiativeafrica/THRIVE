# Database (Supabase Postgres, Railway, Render, or Neon)
# Example Supabase connection string (Transaction Pooler / port 6543 or Direct / port 5432):
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# Admin Portal Credentials (/admin)
# Defaults to "admin123" if not set
ADMIN_PASSWORD="admin123"
SESSION_SECRET="replace-with-a-random-32-char-secret"

# Option A: Supabase Storage for Blog Image Uploads (Recommended if using Supabase DB)
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="blog-images"

# Option B: Cloudinary for Blog Image Uploads
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional Payment & Forms
NEXT_PUBLIC_SITE_URL="https://www.thriveinitiativeafrica.com"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=""
NEXT_PUBLIC_VOLUNTEER_FORM_URL="https://forms.gle/nPNYHSViBTPUryRB6"
